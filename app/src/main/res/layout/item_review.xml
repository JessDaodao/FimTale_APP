<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/reviewTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/reviewNumber" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.Chip android:id="@+id/reviewStatus" style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:checkable="false"
            app:chipStrokeWidth="0dp" />
        <TextView android:id="@+id/reviewReason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textIsSelectable="true" />
        <TextView android:id="@+id/reviewUpdated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/reviewResubmit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.fimtale.ui.icons.MdiButton android:id="@+id/reviewOpenWork" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/review_open_work"
                app:mdiIcon="open-in-new" app:iconSize="@dimen/mdi_icon_size" />
            <com.fimtale.ui.icons.MdiButton android:id="@+id/reviewSubmit" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/review_submit"
                app:mdiIcon="send" app:iconSize="@dimen/mdi_icon_size" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
