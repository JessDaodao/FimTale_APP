<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/reviewTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:maxLines="1" android:ellipsize="end" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip android:id="@+id/reviewStatus" style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:clickable="false" android:checkable="false" app:ensureMinTouchTargetSize="false"
                app:chipStrokeWidth="0dp" app:chipBackgroundColor="?attr/colorSurfaceVariant" />
        </LinearLayout>
        <TextView android:id="@+id/reviewReason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" android:textIsSelectable="true" />
        <TextView android:id="@+id/reviewNumber" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/reviewUpdated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/reviewResubmit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
            <com.fimtale.ui.icons.MdiButton android:id="@+id/reviewOpenWork" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/review_open_work"
                app:mdiIcon="open-in-new" app:iconSize="@dimen/mdi_icon_size" />
            <com.fimtale.ui.icons.MdiButton android:id="@+id/reviewSubmit" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/review_submit"
                app:mdiIcon="send" app:iconSize="@dimen/mdi_icon_size" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
    <View android:id="@+id/reviewDivider" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginHorizontal="20dp" android:background="?attr/colorSurfaceVariant" />
</LinearLayout>
