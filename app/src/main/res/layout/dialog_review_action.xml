<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="8dp">
    <TextView android:id="@+id/reviewActionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/reviewActionProgress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:indeterminate="true" android:layout_marginVertical="12dp" />
    <TextView android:id="@+id/reviewActionError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" android:textColor="?attr/colorError" android:layout_marginTop="12dp" />
</LinearLayout>
