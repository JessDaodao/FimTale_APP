<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:clipChildren="false">
    <ScrollView android:id="@+id/accountScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/accountSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:text="活跃会话" android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:id="@+id/accountSessionHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="以下是当前账号的活跃登录会话和有效 API Token。"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/accountRefresh"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:text="刷新" app:icon="@drawable/ic_history" />
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/accountProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="48dp"
                app:trackThickness="4dp" />
            <LinearLayout android:id="@+id/accountSessions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView android:id="@+id/accountEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="24dp" android:text="暂无有效会话"
                android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="API Token" android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="API Token 是长期有效的会话凭证，新 Token 只会在创建后显示一次。"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/accountCreateToken"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="创建 API Token" app:icon="@drawable/ic_post" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/accountTokenLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:hint="新 API Token" android:visibility="gone" style="@style/Widget.Fimtale.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/accountToken"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"
                    android:focusable="false" android:textIsSelectable="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/accountCopyToken"
                style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="复制 Token" android:visibility="gone" app:icon="@drawable/ic_post" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/accountToolbarContainer"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:layout_margin="16dp"
        android:clipChildren="false" android:clipToPadding="false">
        <com.google.android.material.card.MaterialCardView android:id="@+id/accountHeaderSurface"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:alpha="0" android:importantForAccessibility="no" android:stateListAnimator="@null"
            app:cardBackgroundColor="?android:attr/colorBackground" app:cardCornerRadius="16dp"
            app:cardElevation="4dp" app:strokeWidth="0dp" />
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/accountToolbar"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@null" android:elevation="4dp" android:outlineProvider="none"
            android:stateListAnimator="@null" app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface" app:titleTextColor="?attr/colorOnSurface">
            <TextView android:id="@+id/accountToolbarTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="账户与会话" android:textColor="?attr/colorOnSurface" android:textSize="21sp" />
        </com.google.android.material.appbar.MaterialToolbar>
    </FrameLayout>
</FrameLayout>
